APP_NAME=Resume Parser Service
PUBLIC_API_BASE_URL=
MAX_FILE_SIZE_MB=5
RESUME_IMAGE_MAX_SIZE_MB=5
RESUME_IMAGE_STORAGE_BACKEND=local
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RESUME_IMAGE_S3_KEY_PREFIX=resume-images
# For deployments that store images on the server filesystem set to 'local'.
# To explicitly use local storage (store images under the project dir):
# RESUME_IMAGE_STORAGE_BACKEND=local
# RESUME_IMAGE_STORAGE_DIR=resume-images
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MONGO_URI=
MONGO_DATABASE=resume_parser
MONGO_COLLECTION=parsed_resume
MONGO_EDITED_COLLECTION=edited_resumes
